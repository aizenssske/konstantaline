# Neon PostgreSQL — faqat server tomoni.
# Hech qachon DATABASE_URL ga NEXT_PUBLIC_ prefiksini qo‘ymang.
#
# Vercel + Neon integration odatda ikkala qiymatni ham o‘zi yozadi.
# Pooled URL Next.js serverless runtime uchun.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct URL drizzle-kit migrate va studio uchun.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

# Single-owner login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=generate-a-long-random-secret-at-least-32-characters

# Secret bridge between Telegram bot and Next.js API
BOT_API_SECRET=generate-another-long-random-secret

# Faqat lokal preview uchun. Production’da false qoldiring.
# true bo‘lsa ma’lumotlar xotirada turadi va server qayta ishga tushganda yo‘qoladi.
DEMO_MODE=false
