# Shared database (create a free Supabase project)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Single-owner login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=generate-a-long-random-secret-at-least-32-characters

# Secret bridge between Telegram bot and Next.js API
BOT_API_SECRET=generate-another-long-random-secret

# Set true only for local preview without Supabase (data is not persistent)
DEMO_MODE=false
